# Copy to .env and fill in. .env is gitignored.
# Load in PowerShell:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#]' } | ForEach-Object {
#       $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim())
#   }

GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Prefer certificate auth in production. Secret is for lab/short-lived engagements only.
GRAPH_CLIENT_SECRET=

# Certificate thumbprint (alternative to secret)
GRAPH_CERT_THUMBPRINT=

# Search region: NAM EUR APC GBR AUS CAN IND JPN
GRAPH_REGION=NAM
